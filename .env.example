# The admin API the storefront reads its catalogue, prices and stock from.
# No trailing slash; the version segment is part of it.
#
# Public on purpose. The API has no authentication — it decides who may call it
# from the request's Origin, against the admin's own STOREFRONT_ORIGINS
# allowlist — so the browser is the intended caller and there is no secret in
# this URL. Leave it unset to render the shop from the local fixture instead.
#
# If a signed endpoint is ever added, its key goes in a variable WITHOUT the
# NEXT_PUBLIC_ prefix: anything so named is compiled into the browser bundle.
NEXT_PUBLIC_API_URL=https://your-admin-host/api/v1
